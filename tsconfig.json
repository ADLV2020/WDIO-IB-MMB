{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["./src/core/*"],
      "@page_objects/*": ["./src/page_objects/*"],
      "@steps/*": ["./src/steps/*"],
      "@strategies/*": ["./src/strategies/*"],
      "@facade/*": ["./src/facade/*"],
      "@env/*": ["./config/env/*"]
    },
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/cucumber-framework"
    ],
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./"
  },
  "ts-node": {
    "transpileOnly": true,
    "files": true,
    "require": ["tsconfig-paths/register"]
  },
  "include": [
    "src/**/*.ts",
    "config/**/*.ts",
    "wdio.conf.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
