{
"name": "airline-automation-framework",
  "version": "1.0.0",
  "description": "Framework de automatización WebdriverIO + Cucumber + TypeScript con Reflexividad DOM",
  "main": "index.js",

"scripts": {
    "test:int": "cross-env ENV=INT wdio run config/wdio.conf.ts",
    "test:pre": "cross-env ENV=PRE wdio run config/wdio.conf.ts",
    "test:pro": "cross-env ENV=PRO wdio run config/wdio.conf.ts",
    "report:clean": "rimraf allure-results allure-report",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report"
  },

"keywords": [
    "webdriverio",
    "cucumber",
    "typescript",
    "allure",
    "sdet",
    "automation"
  ],

  "author": "",
  "license": "ISC",

"devDependencies": {
    "@types/node": "^20.11.0",
    "@wdio/allure-reporter": "^8.39.0",
    "@wdio/cli": "^8.39.0",
    "@wdio/cucumber-framework": "^8.39.0",
    "@wdio/local-runner": "^8.39.0",
    "@wdio/spec-reporter": "^8.39.0",
    "allure-commandline": "^2.29.0",
    "chromedriver": "^122.0.0",
    "cross-env": "^7.0.3",
    "date-fns": "^3.6.0",
    "puppeteer-core": "^22.0.0",
    "rimraf": "^5.0.7",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "wdio-chromedriver-service": "^8.1.1"
  }

}
